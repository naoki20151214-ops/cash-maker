---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const base = import.meta.env.BASE_URL;

const formatDate = (d: Date) =>
  d.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
---
<BaseLayout title="記事一覧">
  <h1 class="page-title">記事一覧</h1>
  <ul class="post-list">
    {posts.map((post) => (
      <li class="post-card">
        <a href={`${base}/blog/${post.id}/`}>{post.data.title}</a>
        <p class="post-meta">{formatDate(post.data.pubDate)}</p>
        <p>{post.data.description}</p>
        <div>
          {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
